# Base URL for the dashboard API (docs/network-layer.md §2).
# Falls back to PROD when unset (PROD_API_BASE_URL / UAT_API_BASE_URL in
# api/client.ts).
#
# Copy to .env.local and point it wherever you need — UAT, or a local mock — to
# exercise the network layer without the production API. The trailing slash
# matters: Axios joins it to relative endpoint paths.

# PROD
NEXT_PUBLIC_API_BASE_URL=https://api.bajat.net/api/dashboard/v1/
# UAT
# NEXT_PUBLIC_API_BASE_URL=https://identities.g4t.io/api/dashboard/v1/
