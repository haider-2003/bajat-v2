# Base URL for the dashboard API (docs/network-layer.md §2).
# Falls back to the production host when unset:
#   https://identities.g4t.io/api/dashboard/v1/
#
# Copy to .env.local and point it wherever you need — a staging host, or a
# local mock — to exercise the network layer without the production API.
# The trailing slash matters: Axios joins it to relative endpoint paths.
NEXT_PUBLIC_API_BASE_URL=https://identities.g4t.io/api/dashboard/v1/
