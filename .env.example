# Base URL for the dashboard API (docs/network-layer.md §2).
# Falls back to the production host when unset (`API_HOSTS` in api/client.ts):
#   https://api.bajat.net/api/dashboard/v1/
#
# Copy to .env.local and point it wherever you need — the previous host, a
# staging host, or a local mock — to exercise the network layer without the
# production API. The trailing slash matters: Axios joins it to relative
# endpoint paths.
NEXT_PUBLIC_API_BASE_URL=https://api.bajat.net/api/dashboard/v1/
# Previous host:
# NEXT_PUBLIC_API_BASE_URL=https://identities.g4t.io/api/dashboard/v1/
